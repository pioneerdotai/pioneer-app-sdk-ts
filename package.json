{
  "name": "@pioneer/app-sdk",
  "version": "0.1.0",
  "description": "Pioneer application client and Node.js backend SDK",
  "type": "module",
  "engines": { "node": ">=22" },
  "files": ["dist", "dist-cjs", "src", "README.md", "docs", "fixtures"],
  "exports": {
    "./client": {
      "import": { "types": "./dist/client/index.d.ts", "default": "./dist/client/index.js" },
      "require": { "types": "./dist-cjs/client/index.d.ts", "default": "./dist-cjs/client/index.js" }
    },
    "./server": {
      "import": { "types": "./dist/server/index.d.ts", "default": "./dist/server/index.js" },
      "require": { "types": "./dist-cjs/server/index.d.ts", "default": "./dist-cjs/server/index.js" }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && cp release/cjs-package.json dist-cjs/package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cjs.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:package": "tsx --test tests/package-contract.mts"
  },
  "dependencies": { "ws": "^8.18.3" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/ws": "^8.18.1", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
